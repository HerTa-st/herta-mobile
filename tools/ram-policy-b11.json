{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:PutObject"
      ],
      "Resource": [
        "acs:oss:*:*:<bucket>/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetBucketWebsite",
        "oss:PutBucketWebsite"
      ],
      "Resource": [
        "acs:oss:*:*:<bucket>"
      ]
    }
  ]
}
